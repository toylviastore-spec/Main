{
  "mcpServers": {
    "gmc-toylvia": {
      "command": "C:\\gmc-mcp\\venv\\Scripts\\gmc-mcp.exe",
      "args": ["run"],
      "env": {
        "GMC_ACCOUNT_ID": "${GMC_ACCOUNT_ID}",
        "GMC_SERVICE_ACCOUNT_KEY": "${GMC_SERVICE_ACCOUNT_KEY}"
      }
    },
    "chrome-devtools": {
      "command": "C:\\Program Files\\nodejs\\npx.cmd",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    },
    "analytics-mcp-toylvia": {
      "command": "C:\\analytics-mcp\\venv\\Scripts\\analytics-mcp.exe",
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${GOOGLE_APPLICATION_CREDENTIALS_ANALYTICS}",
        "GOOGLE_PROJECT_ID": "${GOOGLE_PROJECT_ID_ANALYTICS}"
      }
    },
    "gsc": {
      "command": "C:\\Users\\zikob\\.local\\bin\\uvx.exe",
      "args": ["mcp-search-console"],
      "env": {
        "GSC_CREDENTIALS_PATH": "${GSC_CREDENTIALS_PATH}",
        "GSC_SKIP_OAUTH": "true"
      }
    },
    "google-ads-mcp": {
      "command": "C:\\Users\\zikob\\AppData\\Roaming\\Python\\Python314\\Scripts\\pipx.exe",
      "args": ["run", "--spec", "git+https://github.com/googleads/google-ads-mcp.git", "google-ads-mcp"],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${GOOGLE_APPLICATION_CREDENTIALS_ADS}",
        "GOOGLE_PROJECT_ID": "${GOOGLE_PROJECT_ID_ADS}",
        "GOOGLE_ADS_DEVELOPER_TOKEN": "${GOOGLE_ADS_DEVELOPER_TOKEN}",
        "GOOGLE_ADS_LOGIN_CUSTOMER_ID": "${GOOGLE_ADS_LOGIN_CUSTOMER_ID}"
      }
    }
  }
}