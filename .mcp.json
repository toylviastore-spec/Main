{
  "mcpServers": {
    "gmc": {
      "command": "gmc-mcp",
      "args": ["run"],
      "env": {
        "GMC_ACCOUNT_ID": "REPLACE_WITH_10_DIGIT_MERCHANT_CENTER_ID",
        "GMC_SERVICE_ACCOUNT_KEY": "REPLACE_WITH_ABS_PATH_TO_service-account.json"
      }
    },
    "chrome-devtools": {
      "command": "C:\\Program Files\\nodejs\\npx.cmd",
      "args": ["-y", "chrome-devtools-mcp@latest", "--autoConnect"]
    }
  }
}
